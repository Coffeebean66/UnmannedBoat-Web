# 高德开放平台：应用管理 -> 新建应用 -> Web 端（JS API）。
# 将下面的空值替换为同一 Key 对应的 32 位 Key 和安全密钥，并配置域名白名单。
# Node 不会自动加载本文件；开发时设置 PowerShell 环境变量，服务器通过 systemd EnvironmentFile 载入。
# 管理员也可在网页“设置 → 平台地图设置”中保存，已保存配置优先于下方环境变量。
BOAT_AMAP_KEY=
BOAT_AMAP_SECURITY_CODE=
# 可选卫星来源：天地图控制台申请的浏览器端 32 位 Key；不影响高德平面图。
# 留空仍可用 ArcGIS World Imagery，申请与切换教程见 MAP_SETUP.md。
BOAT_TIANDITU_KEY=
# 可选：指定源码目录外的绝对文件路径；未指定则使用更新服务/systemd状态目录或当前用户配置目录。
# BOAT_MAP_CONFIG_FILE=/var/lib/unmanned-boat-web/map-settings.json

# 航线库：任务名称、航速、半径及 WGS84 航点按设备 ID 保存；运行状态不自动恢复。
# 默认使用在线更新 requests / systemd StateDirectory / 当前用户配置目录，更新代码不会覆盖。
# 可选自定义绝对路径，其父目录必须允许网页服务写入；部署说明见 MISSION_SETUP.md。
# BOAT_MISSION_FILE=/var/lib/unmanned-boat-web/missions.json

# 船载视频：默认仅允许网站同源媒体，无需额外配置。
# 跨域时按逗号或空白分隔填写精确 HTTP(S) origin（协议、域名及可选端口），最多16个。
# 不填路径、查询参数、账号或通配符；例如 https://video.example.com,https://cdn.example.com:8443。
# 视频服务还须配置 CORS；HTTPS 页面应使用 HTTPS 视频，完整步骤见 VIDEO_SETUP.md。
BOAT_VIDEO_ALLOWED_ORIGINS=

# 低延迟视频：SRT（UDP）上传，由 MediaMTX 转为 WebRTC；默认关闭。
# Linux 请运行 maintenance/install-video-media.sh 自动生成配置和私密凭据，详见 VIDEO_UDP_SETUP.md。
# 以下仅展示变量名；不能使用空密码启用，勿将生成后的私密值上传仓库或发给浏览器。
BOAT_VIDEO_MEDIA_ENABLED=0
BOAT_VIDEO_MEDIA_PUBLIC_HOST=
BOAT_VIDEO_SRT_PORT=8890
BOAT_VIDEO_WEBRTC_PORT=8189
BOAT_VIDEO_MEDIA_AUTH_TOKEN=
BOAT_VIDEO_MEDIA_READER_PASSWORD=

# 可选的原始 UDP 输入：默认 RTP / H.264，也支持 MPEG-TS，与其他船的 SRT 输入并存。
# 使用安装脚本时一起传入 BOAT_VIDEO_UDP_DEVICE 和 BOAT_VIDEO_UDP_PORT，将一个端口绑定到一艘船。
# 示例：sudo env BOAT_VIDEO_UDP_DEVICE=boat-01 BOAT_VIDEO_UDP_PORT=8000 bash maintenance/install-video-media.sh boat.example.com 7890
# 默认留空不新增 UDP 监听；升级时保留服务器已有的 UDP source、端口及服务 drop-in。
# 原始 UDP 数据包没有用户名/密码校验，请在云安全组或防火墙限制发送端来源。
# 同一船的视频路径使用一种输入；其他船仍可使用 SRT。Node 不会自动加载本文件。
BOAT_VIDEO_UDP_DEVICE=
BOAT_VIDEO_UDP_PORT=
# 显式配置 UDP 来源时默认 rtp；发送 MPEG-TS 时填写 mpegts，不能把两种封装混用。
# RTP 模式还要求 MediaMTX 的 rtpSDP 与发送端的编码和 payload type 一致。
BOAT_VIDEO_UDP_FORMAT=rtp
# RTP / H.264 动态 payload type，96..127，默认96；MPEG-TS 模式不使用。
# 现有服务器升级保留原始 rtpSDP；高级 SDP 参数直接在服务器媒体配置中维护。
BOAT_VIDEO_UDP_PAYLOAD_TYPE=96

# 服务器录像：先更新网页，再重新运行 maintenance/install-video-media.sh。
# 安装脚本启用本机媒体控制/回放接口，并授予媒体服务下方根目录的写入权限。
# 管理员在“平台设置 → 服务器录像”修改保存目录，仅允许此根目录内的目录。
# 默认保存至 /var/lib/unmanned-boat-video/recordings，按船分目录；默认每段60秒、保留7天。
BOAT_VIDEO_RECORDING_ENABLED=0
BOAT_VIDEO_RECORDING_ROOT=/var/lib/unmanned-boat-video
# 可选：录像设置文件（不是视频文件）的源码目录外绝对路径。
# 不填时使用 STATE_DIRECTORY 或现有更新组件的 requests 状态目录；本机无状态目录则仅内存保存。
BOAT_VIDEO_RECORDING_CONFIG_FILE=

# 服务器持续记录遥测，不要求浏览器保持打开或先点击连接。
# 非空显式路径优先；否则systemd使用 STATE_DIRECTORY/telemetry-history.json。
# 无STATE_DIRECTORY但BOAT_UPDATE_ENABLED=1的旧部署使用 BOAT_UPDATE_STATE_DIR/requests/telemetry-history.json，
# 更新状态目录默认 /var/lib/unmanned-boat-web-update。下方路径留空会使用这些默认值。
# 普通本机无上述状态目录/更新组件配置且未设置路径时仅保存在内存，重启Node会丢失。
# 可填写源码目录外的可写绝对路径，例如 /var/lib/unmanned-boat-web/telemetry-history.json。
# 默认每船每秒采样一次、最多3600点，连续记录约1小时；超过24小时的旧记录也会淘汰。
# 页面每次最多加载1000点、轨迹最多1000点，曲线显示最后12秒；页面显示范围小于服务器保留范围。
# 最多64船且全部船合计最多20000点，达到全局上限时按时间淘汰最旧点；这些上限不通过环境变量修改。
# 每10秒异步原子写盘，正常停止会等待保存；强制结束/断电可能丢失最近未落盘数据。
# Node 不会自动加载本文件，请由环境变量或 systemd EnvironmentFile 载入；运行生成的数据不要上传仓库。
BOAT_TELEMETRY_HISTORY_FILE=
# 允许10..3600点。
BOAT_TELEMETRY_HISTORY_MAX_POINTS=3600
# 允许100..60000毫秒。
BOAT_TELEMETRY_HISTORY_SAMPLE_MS=1000
# 允许60000..2592000000毫秒（1分钟..30天）。
BOAT_TELEMETRY_HISTORY_MAX_AGE_MS=86400000

# STM32 OTA：留空禁用。先有线烧入OTA Bootloader和0x08020000应用，并同步设置32字节密钥。
# 必须为64个十六进制字符；在服务器私密EnvironmentFile中填写，绝不能放前端、仓库或上传文件。
# 服务端会为通过校验的应用BIN生成HMAC-SHA256 manifest；需要平台管理员和MQTT OTA主题ACL。
BOAT_OTA_KEY=
